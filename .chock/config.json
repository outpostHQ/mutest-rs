{
  "$schema": "https://raw.githubusercontent.com/outpostHQ/chock/main/schema/config-v1.json",
  "version": 1,
  "enabled": [
    "admits",
    "assertions",
    "bigfiles",
    "binsize",
    "citations",
    "claims",
    "codeslop",
    "commands-build",
    "commits",
    "complexity",
    "coverage",
    "crap",
    "deps",
    "doc",
    "dupdeps",
    "duplication",
    "features",
    "hygiene",
    "lean",
    "manifest",
    "modcheck",
    "nesting",
    "placement",
    "profile",
    "slop",
    "sort",
    "source",
    "splits",
    "supply",
    "test",
    "testlint",
    "toolchain",
    "typos",
    "unsafety",
    "unused",
    "wiring"
  ],
  "left_off": {
    "lint": "off by the owner's choice: upstream mutest-rs is not rustfmt-formatted or clippy-clean, and reformatting it would conflict every upstream merge",
    "msrv": "off: mutest-rs builds only on the nightly rust-toolchain.toml pins, so it promises no minimum Rust version"
  },
  "runner": [
    "sh",
    "-c",
    "exec bash bin/test"
  ],
  "coverage": [
    "sh",
    "-c",
    "exec bash bin/coverage \"$0\"",
    "{lcov}"
  ],
  "runner_tools": [
    "cargo",
    "rustup"
  ],
  "commands": [
    {
      "name": "mutest-json-alone",
      "run": [
        "cargo",
        "build",
        "-p",
        "mutest-json"
      ],
      "builds": true
    },
    {
      "name": "corpus",
      "run": [
        "sh",
        "-c",
        "exec bash bin/corpus \"$@\"",
        "sh",
        "itoa",
        "anyhow"
      ],
      "builds": true
    }
  ]
}
