#!/usr/bin/env bash
# Runs the tests of bin/test with coverage instrumentation, and writes an LCOV report to the path given.
set -uo pipefail
lcov=${1:?usage: bin/coverage <LCOV_PATH>}
case $lcov in /* | [A-Za-z]:[\\/]*) ;; *) lcov=$PWD/$lcov ;; esac
cd "$(dirname "$0")/.."

# Test binaries cannot link an instrumented runtime, so the driver embeds this uninstrumented one.
cargo build --release -p mutest-runtime || exit 1
rustup target add aarch64-unknown-none || exit 1
cargo build --release --target aarch64-unknown-none -p test-metadata-shim -p mutest-runtime-embedded-target-stub || exit 1
export MUTEST_RUNTIME_TARGET_DIR=$PWD/target

# cargo-llvm-cov reports one profile, so every test runs in release, in a target directory of its own.
export CARGO_TARGET_DIR=$PWD/target/release/coverage
mkdir -p "$CARGO_TARGET_DIR" || exit 1
env_script=$(cargo llvm-cov show-env --sh) || exit 1
eval "$env_script"
export LLVM_PROFILE_FILE=$CARGO_TARGET_DIR/mutest-rs-%8m.profraw
cargo llvm-cov clean --workspace --profraw-only || exit 1

failed=""
log=$CARGO_TARGET_DIR/test-output.log
: > "$log"
built=$CARGO_TARGET_DIR/built-executables
: > "$built"
executables() { sed -n 's/.*"executable":"\([^"]*\)".*/\1/p' >> "$built"; }
for package in cargo-mutest mutest-driver mutest-emit mutest-exit-code mutest-runtime mutest-inspector mutest-tests; do
    cargo test --release -p "$package" --no-run --message-format=json-render-diagnostics | executables || failed+=" build:$package"
    cargo test --release -p "$package" --no-fail-fast 2>&1 | tee -a "$log" || failed+=" test:$package"
done
cargo build --release -p mutest-tests --message-format=json-render-diagnostics | executables || failed+=" build:mutest-tests"
cargo run --release -p mutest-tests 2>&1 | tee -a "$log" || failed+=" ui-test"
# Test children that run with a cleared environment write their profiles to their working directory.
find . -path ./target -prune -o -name "default_*.profraw" -exec mv {} "$CARGO_TARGET_DIR" \;
# cargo-llvm-cov reads every executable in the target directory, and one an earlier build left holds old line numbers.
# Tests build cargo-mutest themselves, so the latest binaries at the top of release/ stay too.
[ -s "$built" ] && find "$CARGO_TARGET_DIR/release" -type f -perm -u+x ! -name "build_script_build*" ! -name "*.so" ! -name "*.dylib" ! -name "*.dll" -exec ls -di {} + \
    | awk 'NR == FNR { keep[$1]; next } !($1 in keep) { print $2 }' \
        <(xargs ls -di < "$built"; find "$CARGO_TARGET_DIR/release" -maxdepth 1 -type f -exec ls -di {} +) - | xargs rm -f
cargo llvm-cov report --release --lcov --output-path "$lcov" || exit 1
# chock shows only the end of a failed run, so it repeats each failure there.
[ -z "$failed" ] || { grep -E "panicked at|FAILED|^---- " "$log" | tail -40 >&2; echo "bin/coverage: these steps failed:$failed" >&2; exit 1; }
